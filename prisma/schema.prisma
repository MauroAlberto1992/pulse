generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One probe of one target. Pruned after RETENTION_DAYS.
model Check {
  id         BigInt   @id @default(autoincrement())
  target     String
  ok         Boolean
  statusCode Int?
  latencyMs  Int
  /// Pulse's own short label ("timeout", "HTTP 503", "down: mongo"), never a raw response body.
  error      String?
  checkedAt  DateTime @default(now())

  @@index([target, checkedAt])
  @@index([checkedAt])
}

/// Opened after FAILURE_THRESHOLD consecutive failed checks, closed on the first success.
model Incident {
  id       Int       @id @default(autoincrement())
  target   String
  openedAt DateTime  @default(now())
  closedAt DateTime?
  cause    String?

  @@index([target, closedAt])
  @@index([openedAt])
}

/// A warn/error line shipped by an app (redacted at the source and again on ingest).
/// Pruned after LOG_RETENTION_DAYS.
model LogEntry {
  id          BigInt   @id @default(autoincrement())
  /// When the app logged it (from the payload).
  timestamp   DateTime
  receivedAt  DateTime @default(now())
  /// "api" or "web".
  service     String
  /// The app's environment, e.g. "production" or "staging".
  environment String
  level       String
  context     String?
  message     String
  stack       String?

  @@index([timestamp])
  @@index([service, level, timestamp])
}
