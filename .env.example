# Pulse's own Postgres (a separate Railway database, never the main app's).
DATABASE_URL=postgresql://user:password@localhost:5432/pulse?schema=public
PORT=3000
# production: session cookie is Secure and Express trusts Railway's proxy.
NODE_ENV=

# --- Login (single user, no dependency on api_cp) ---
# npm run hash-password -- '<your password>'
PULSE_PASSWORD_HASH=
# Optional TOTP (authenticator app). npm run new-totp-secret prints a secret and an otpauth:// URI.
PULSE_TOTP_SECRET=
# Signs the session cookie. openssl rand -hex 32
SESSION_SECRET=

# --- What to monitor ---
# JSON array. "deep": true sends x-health-secret: HEALTH_CHECK_SECRET (api_cp's /api/health/deep).
PULSE_TARGETS=[{"name":"web","url":"https://espion.pt"},{"name":"api","url":"https://<api host>/api/health/deep","deep":true}]
# Same value as HEALTH_CHECK_SECRET on api_cp.
HEALTH_CHECK_SECRET=
CHECK_INTERVAL_SECONDS=60
CHECK_TIMEOUT_MS=10000
# Consecutive failures before an incident opens (and an email goes out).
FAILURE_THRESHOLD=3
# Days of check history kept; pruned nightly.
RETENTION_DAYS=30

# --- Alerts (Brevo transactional email) ---
BREVO_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- Watching the watcher ---
# Ping URL of an external dead-man's switch (e.g. https://hc-ping.com/<uuid>). Pinged after each
# check round; that service emails you if the pings stop (pulse or Railway down).
HEARTBEAT_URL=
